          "datasource": "Prometheus"
        },
        {
          "expr": "sum(rate(pii_requests_total{type=\"unmask\"}[1m]))",
          "legendFormat": "unmask",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
